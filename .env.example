# Copy this file to .env and fill in your keys. server.js reads .env on startup.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Optional
# PORT=3000
# FORCE_SAMPLE=1        # skip ClinicalTrials.gov and always use data/sample_trials.json (bad venue wifi)
# MATCH_EFFORT=low      # Claude effort for trial matching: low | medium | high
# CRISIS_MODEL=claude-sonnet-5-5      # safety classifier
# MATCH_MODEL=claude-sonnet-5-5       # eligibility / fit analysis
# TRANSLATE_MODEL=claude-haiku-5-5    # translation for Listen
